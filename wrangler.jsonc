/**
 * Haven OS — the deploy config, at repo root where the Deploy to Cloudflare
 * button (and Workers Builds) looks for it. Generated by scripts/make-template.mjs
 * in the source repo; edit it there, not here, or a rebuild will undo you.
 *
 * SUPABASE_URL is deliberately NOT in vars: the deploy screen prompts for it
 * (via .env.example) and stores it as a Worker secret — one field, one value,
 * no precedence question (scratch-run F2).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haven-os",
	"main": "backend/src/index.ts",
	"compatibility_date": "2026-05-31",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	// The workers.dev URL is the house's front door (no custom domain needed);
	// preview URLs are surface with no purpose here. Pinned so Cloudflare's
	// defaults-with-warnings never decide either one (scratch-run F14).
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"ENVIRONMENT": "production",
		"NOTION_VERSION": "2025-09-03",
		// The gallery bucket's NAME, for presigned reference URLs (the binding
		// hides it, the S3 URL needs it). If you rename the GALLERY bucket at
		// deploy time, change this to match.
		"GALLERY_BUCKET": "haven-gallery"
	},
	/**
	 * The seven managed keys — Secrets Store bindings, values set in-app
	 * through the setup wizard and the Fuse Box keys circuit, never here.
	 * secret_name === binding name on purpose (scratch-run F6): the Deploy
	 * button creates the store secrets under the binding names, and the
	 * runtime lookup is case-sensitive. The store_id placeholder is rewritten
	 * to your account's real store by the Deploy button.
	 */
	"secrets_store_secrets": [
		{ "binding": "ANTHROPIC_API_KEY", "store_id": "00000000000000000000000000000000", "secret_name": "ANTHROPIC_API_KEY" },
		{ "binding": "ELEVENLABS_API_KEY", "store_id": "00000000000000000000000000000000", "secret_name": "ELEVENLABS_API_KEY" },
		{ "binding": "GETIMG_API_KEY", "store_id": "00000000000000000000000000000000", "secret_name": "GETIMG_API_KEY" },
		{ "binding": "HA_MCP_URL", "store_id": "00000000000000000000000000000000", "secret_name": "HA_MCP_URL" },
		{ "binding": "HA_TOKEN", "store_id": "00000000000000000000000000000000", "secret_name": "HA_TOKEN" },
		{ "binding": "NOTION_TOKEN", "store_id": "00000000000000000000000000000000", "secret_name": "NOTION_TOKEN" },
		{ "binding": "OPENROUTER_API_KEY", "store_id": "00000000000000000000000000000000", "secret_name": "OPENROUTER_API_KEY" }
	],
	"assets": {
		"directory": "frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// The Gallery sweeper — re-drives generations whose background work was
	// cut off; a quiet no-op when nothing is stuck (or the Gallery is unlit).
	"triggers": { "crons": ["* * * * *"] },
	// Bucket names are yours — the Deploy button lets you rename them at
	// deploy time and binds whatever you choose.
	"r2_buckets": [
		{ "binding": "VOICE_NOTES", "bucket_name": "haven-voice-notes" },
		{ "binding": "GALLERY", "bucket_name": "haven-gallery" }
	]
}
